rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null;
    }

    function isMember(houseId) {
      return signedIn() &&
        exists(/databases/$(database)/documents/houses/$(houseId)/members/$(request.auth.uid));
    }

    match /houses/{houseId} {
      // Permite criar uma casa autenticado anonimamente.
      allow create: if signedIn();

      // Ler/alterar a casa somente depois de virar membro.
      allow read, update: if isMember(houseId);
      allow delete: if false;

      match /members/{uid} {
        // Quem tem o código pode criar apenas seu próprio cadastro de membro.
        allow create: if signedIn() && request.auth.uid == uid
          && request.resource.data.uid == request.auth.uid;

        allow read: if isMember(houseId);
        allow update: if signedIn() && request.auth.uid == uid && isMember(houseId);
        allow delete: if signedIn() && request.auth.uid == uid;
      }

      match /items/{itemId} {
        allow read, create, update, delete: if isMember(houseId);
      }

      match /purchases/{purchaseId} {
        allow read, create, update, delete: if isMember(houseId);
      }
    }
  }
}
